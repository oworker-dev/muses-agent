{
  "name": "muses-agent",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "npm run build:sdk && next build",
    "build:sdk": "npm run build --workspace @muses/agent-contracts && npm run build --workspace @muses/agent-client && npm run build --workspace @muses/agent-host && npm run build --workspace @muses/agent-ui",
    "db:migrate": "node scripts/migrate-agent-data.mjs",
    "dev": "npm run build:sdk && next dev",
    "start": "next start",
    "typecheck": "npm run build:sdk && tsc --noEmit -p tsconfig.json",
    "build:eve": "npm run build:sdk && eve build",
    "build:examples": "npm run build --workspace @muses/example-custom-host-react",
    "dev:eve": "eve dev",
    "doctor:production": "node scripts/doctor-production.ts",
    "eval:fixed": "node scripts/run-fixed-evals.mjs",
    "start:eve": "eve start",
    "test:e2e": "playwright test",
    "test:unit": "npm run build:sdk && node --test tests/unit/*.test.ts",
    "verify:agent-run-api": "node scripts/verify-agent-run-api.mjs",
    "verify:custom-host-example": "npm run build:examples",
    "verify:sdk-packages": "npm run build:sdk && node scripts/verify-sdk-packages.mjs",
    "verify:sandbox": "node scripts/verify-sandbox-docker.mjs",
    "verify:muses-host-e2e": "node scripts/verify-muses-host-e2e.mjs",
    "mock:openai": "node scripts/mock-openai-responses.mjs",
    "mock:otlp": "node scripts/mock-otlp-json.mjs",
    "reap:sandboxes": "node scripts/reap-docker-sandboxes.mjs",
    "verify:otel": "node scripts/verify-otel-export.mjs",
    "verify:extensions": "node scripts/verify-extension-lifecycle.mjs",
    "verify:provider-failures": "node scripts/verify-provider-failures.mjs",
    "verify:sandbox-reaper": "node scripts/verify-sandbox-reaper.mjs"
  },
  "dependencies": {
    "@muses/agent-client": "0.1.0-alpha.3",
    "@muses/agent-contracts": "0.1.0-alpha.3",
    "@muses/agent-host": "0.1.0-alpha.3",
    "@muses/agent-ui": "0.1.0-alpha.3",
    "@ai-sdk/openai": "^4.0.24",
    "@opentelemetry/api": "1.9.1",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "4.1.0",
    "@shikijs/engine-javascript": "4.1.0",
    "@shikijs/engine-oniguruma": "4.1.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "0.4.2",
    "@vercel/otel": "^2.1.3",
    "@workflow/world-postgres": "^5.0.0-beta.30",
    "ai": "^7.0.34",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "0.27.8",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.3.0-preview.10",
    "pg": "^8.22.0",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "4.1.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "24.x",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "ai": "^7.0.34",
    "postcss": "8.5.25"
  },
  "engines": {
    "node": "24.x"
  }
}

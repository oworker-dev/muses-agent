{
  "name": "@muses/agent-host",
  "version": "0.1.0-alpha.8",
  "private": true,
  "description": "Server-side Host Capability SDK for Muses Agent integrations.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/capability-client.d.ts",
      "import": "./dist/capability-client.js"
    },
    "./registry": {
      "types": "./dist/capability-registry.d.ts",
      "import": "./dist/capability-registry.js"
    },
    "./signature": {
      "types": "./dist/capability-signature.d.ts",
      "import": "./dist/capability-signature.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@muses/agent-contracts": "0.1.0-alpha.8"
  },
  "engines": {
    "node": ">=20"
  }
}

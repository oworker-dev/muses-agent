{
  "name": "@muses/agent-ui",
  "version": "0.1.0-alpha.5",
  "private": true,
  "description": "Reusable React workspace and AI Elements for the Muses Agent service.",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-workspace": {
      "types": "./dist/agent-workspace/index.d.ts",
      "import": "./dist/agent-workspace/index.js"
    },
    "./ai-elements": {
      "types": "./dist/ai-elements/index.d.ts",
      "import": "./dist/ai-elements/index.js"
    },
    "./ai-elements/*": {
      "types": "./dist/ai-elements/*.d.ts",
      "import": "./dist/ai-elements/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "radix-ui": "1.4.3",
    "shiki": "4.1.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "use-stick-to-bottom": "1.1.4"
  },
  "peerDependencies": {
    "ai": ">=7.0.0 <8.0.0",
    "eve": ">=0.27.8 <0.28.0",
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
